<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="service.activeareasubtitles" name="Active Area Subtitles" version="1.6.0" provider-name="Active Area Subtitles">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
    </requires>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.python.script" library="default.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Keeps subtitles inside the picture instead of the black bars</summary>
        <description lang="en_GB">Shows text subtitles just inside the picture of widescreen content instead of in the black bars. The picture is measured at the start of playback, and your own subtitle settings are restored when playback ends. On CoreELEC, text subtitles follow Dolby Vision films whose picture changes shape between scenes (IMAX), and image subtitles (such as PGS) are kept inside the picture where CoreELEC can place them.</description>
        <platform>android-armv7 android-aarch64 android-i686 android-x86_64 freebsd linux windows-i686 windowsstore ios-aarch64 tvos-aarch64</platform>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
<addon id="repository.activeareasubtitles" name="Active Area Subtitles Repository" version="1.1.0" provider-name="Active Area Subtitles">
    <extension point="xbmc.addon.repository" name="Active Area Subtitles Repository">
        <dir>
            <info compressed="false">https://berserker-git.github.io/active-area-subtitles-kodi/zips/addons.xml</info>
